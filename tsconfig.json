{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "paths": {
      "gemini-lb": ["./packages/gemini-lb/src/index.ts"]
    }
  },
  "include": ["dashboard/**/*", "scripts/**/*", "test/**/*"],
  "exclude": ["node_modules", "dist", "packages", "test/result.ts"]
}
