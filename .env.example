# Copy to .env and fill in your values

# Redis connection (Upstash, local, etc.)
REDIS_URL=redis://localhost:6379

# Dashboard login password (REQUIRED for `npm run dashboard`)
DASHBOARD_PASSWORD=

# Dashboard bind (use 0.0.0.0 to expose on your network)
DASHBOARD_PORT=4870
DASHBOARD_HOST=127.0.0.1

# Optional: seed API keys on first run (comma-separated)
# GEMINI_API_KEYS=AIza...,AIza...
# Optional model override for `npm run test:tokenharbor`
# TOKENHARBOR_TEST_MODEL=deepseek-v4.1-flash:free
